# Copie este arquivo para ".env" e preencha os valores.

# Token da API do Autentique (painel > perfil > API). NUNCA compartilhe.
AUTENTIQUE_TOKEN=seu_token_aqui

# Porta do backend
PORT=3333

# URL pública onde o sistema fica acessível (sem barra no final).
# Em produção, use seu domínio: https://contratos.seudominio.com.br
PUBLIC_BASE_URL=http://localhost:3333

# Super-admin INICIAL do painel (criado automaticamente só na 1ª execução,
# quando ainda não existe nenhum usuário). Depois, gerencie a equipe pelo
# menu "Usuários" no painel. Use este e-mail/senha para o primeiro login.
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_NOME=Administrador
ADMIN_PASSWORD=defina-uma-senha-forte

# Segredo para assinar a sessão do admin (gere algo aleatório e longo)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Ambiente. Em "production", a ausência/invalidez de DATA_ENCRYPTION_KEY
# BLOQUEIA o acesso aos dados pessoais (não sobe dado sem chave válida).
NODE_ENV=development

# Chave de criptografia dos dados pessoais do cliente (form_data), AES-256-GCM.
# OBRIGATÓRIA em produção. Gere uma string longa e aleatória e NUNCA versione.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# ⚠ ATENÇÃO: a PERDA desta chave torna os dados pessoais já gravados
# IRRECUPERÁVEIS (não há como descriptografar). Trocar a chave também invalida
# o que já estava criptografado. Guarde-a em um cofre de segredos (ex.: gerenciador
# de segredos da hospedagem) e faça BACKUP seguro. Veja docs/SEGURANCA.md.
DATA_ENCRYPTION_KEY=

# Link da política de privacidade exibido no aviso do formulário do cliente.
# Também é configurável pelo painel (Empresa). Deixe vazio se não tiver.
PRIVACY_POLICY_URL=

# Proxy reverso da hospedagem: nº de proxies à frente para o rate limit usar o IP
# REAL do cliente. Deixe vazio em dev (sem proxy). Em produção atrás de 1 proxy: 1.
# NÃO use 'true' (confiaria em X-Forwarded-For arbitrário/manipulável).
TRUST_PROXY=

# true = cria documentos em modo TESTE no Autentique (sem custo, não valem como contrato).
# Deixe true enquanto testa; mude para false quando for pra valer.
AUTENTIQUE_SANDBOX=true

# Segredo do webhook do Autentique (opcional, mas recomendado).
# Configure o mesmo valor no painel do Autentique ao cadastrar o webhook.
AUTENTIQUE_WEBHOOK_SECRET=

# Modo de teste seguro: com AUTENTIQUE_SANDBOX=true, redireciona os signatários
# fixos para este e-mail (sem notificar os reais). Deixe vazio em produção.
TEST_SIGNER_EMAIL=

# Validade padrão dos links gerados para o cliente (em dias)
LINK_EXPIRATION_DAYS=7

# ----- E-mail (Opção A: enviar ao cliente o link de assinatura por e-mail) -----
# Deixe VAZIO para manter o envio de e-mail desligado (só WhatsApp pela Autentique).
# Para ligar via SMTP (ex.: Google Workspace com senha de app):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=contratos@suaempresa.com.br
#   SMTP_PASS=senha-de-app-de-16-digitos
#   MAIL_FROM="Contratos <contratos@suaempresa.com.br>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
