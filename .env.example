# Copie este arquivo para ".env" e preencha os valores.

# Token da API do Autentique (painel > perfil > API). NUNCA compartilhe.
AUTENTIQUE_TOKEN=seu_token_aqui

# Porta do backend
PORT=3333

# URL pública onde o sistema fica acessível (sem barra no final).
# Em produção, use seu domínio: https://contratos.seudominio.com.br
PUBLIC_BASE_URL=http://localhost:3333

# Senha única de acesso ao painel admin
ADMIN_PASSWORD=defina-uma-senha-forte

# Segredo para assinar a sessão do admin (gere algo aleatório e longo)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# true = cria documentos em modo TESTE no Autentique (sem custo, não valem como contrato).
# Deixe true enquanto testa; mude para false quando for pra valer.
AUTENTIQUE_SANDBOX=true

# Segredo do webhook do Autentique (opcional, mas recomendado).
# Configure o mesmo valor no painel do Autentique ao cadastrar o webhook.
AUTENTIQUE_WEBHOOK_SECRET=

# Modo de teste seguro: com AUTENTIQUE_SANDBOX=true, redireciona os signatários
# fixos para este e-mail (sem notificar os reais). Deixe vazio em produção.
TEST_SIGNER_EMAIL=

# Validade padrão dos links gerados para o cliente (em dias)
LINK_EXPIRATION_DAYS=7
